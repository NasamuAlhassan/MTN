{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "vite/client", "vitest/globals"],
    "resolveJsonModule": true
  },
  "include": ["src", "api", "vite.config.js", "vitest.config.js", "eslint.config.js"],
  "exclude": ["node_modules", "dist", "coverage"]
}
