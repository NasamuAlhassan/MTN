# Copy this file to ".env" and paste your keys.
# Never commit your real .env — it's already in .gitignore.
#
# The two *_API_KEY vars below are SERVER-ONLY secrets. They have NO "VITE_"
# prefix, so Vite will NOT embed them in the client bundle. They are used only
# by the proxy in api/_lib/handlers.js (Vercel functions in prod, Vite dev
# middleware locally). On Vercel, set these in Project Settings → Environment
# Variables.

# Khaya (voice for Twi/Kusaal) — https://translation.ghananlp.org
KHAYA_API_KEY=your_khaya_subscription_key_here

# Google Gemini (free tier — smarter understanding) — https://aistudio.google.com/apikey
# Optional fallback brain: without this and without Groq, Zigi uses rule-based intents only.
GEMINI_API_KEY=your_gemini_api_key_here

# Groq (free, fast) — Whisper speech recognition + Llama NLU. https://console.groq.com/keys
# Preferred over Gemini for NLU, and over Web Speech for English STT.
GROQ_API_KEY=your_groq_api_key_here

# Public feature flags (safe to embed in the client bundle). Set to "true" only
# when the matching server key above is configured.
VITE_VOICE_ENABLED=false
VITE_AI_NLU_ENABLED=false
VITE_GROQ_ENABLED=false
